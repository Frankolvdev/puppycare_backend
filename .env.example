APP_NAME=PuppyCare API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Generate long random values. Never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
BACKOFFICE_SESSION_SECRET=replace-with-another-long-random-secret
SESSION_HTTPS_ONLY=false

# Local Python example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/puppycare
#
# Local Docker example:
# DATABASE_URL=postgresql+psycopg://postgres:password@host.docker.internal:5432/puppycare
#
# AWS RDS example:
# DATABASE_URL=postgresql+psycopg://puppycare_user:password@your-rds-endpoint:5432/puppycare
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/puppycare

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# In AWS, mount EFS at /app/uploads.
UPLOAD_DIR=uploads

# Keep false for normal service startup. Enable only when one controlled
# task should apply Alembic migrations before launching the API.
RUN_DB_MIGRATIONS=false

GOOGLE_CLIENT_ID=
